<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget, for the smallest sizes: the icon only. See SleepWidget.kt -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/app_name">

    <!-- Disabled while no timer runs: see widget_icon_background and widget_icon_tint. -->
    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_icon_background"
        android:enabled="false"
        android:importantForAccessibility="no"
        android:padding="6dp"
        android:src="@drawable/ic_tile"
        android:tint="@color/widget_icon_tint" />
</FrameLayout>
