<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget, when wide enough: the icon next to the app name and the label. See SleepWidget.kt -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/app_name"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="@dimen/widget_padding">

    <!-- Disabled while no timer runs: see widget_icon_background and widget_icon_tint. -->
    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_icon_background"
        android:enabled="false"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_tile"
        android:tint="@color/widget_icon_tint" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_on_background"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/tile_subtitle"
            android:textColor="@color/widget_on_background_variant"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
