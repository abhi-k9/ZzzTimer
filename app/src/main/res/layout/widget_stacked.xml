<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget, for a single cell: the icon above the label. See SleepWidget.kt -->
<!-- A compound drawable can't have the icon's background and tint: hence UseCompoundDrawables. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/app_name"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding"
    tools:ignore="UseCompoundDrawables">

    <!-- Disabled while no timer runs: see widget_icon_background and widget_icon_tint. -->
    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/widget_icon_background"
        android:enabled="false"
        android:importantForAccessibility="no"
        android:padding="6dp"
        android:src="@drawable/ic_tile"
        android:tint="@color/widget_icon_tint" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/tile_subtitle"
        android:textColor="@color/widget_on_background"
        android:textSize="12sp" />
</LinearLayout>
