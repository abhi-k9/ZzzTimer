<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview before Android 12, which uses the widget layout itself instead (previewLayout). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="72dp"
        android:height="72dp"
        android:drawable="@drawable/widget_background" />
    <item
        android:width="40dp"
        android:height="40dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/widget_active" />
        </shape>
    </item>
    <item
        android:width="26dp"
        android:height="26dp"
        android:drawable="@drawable/ic_tile"
        android:gravity="center" />
</layer-list>
