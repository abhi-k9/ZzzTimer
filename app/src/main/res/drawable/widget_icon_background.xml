<?xml version="1.0" encoding="utf-8"?>
<!-- Widget icon: filled with the accent color while a timer runs (enabled), see SleepWidget.kt -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/widget_idle" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_active" />
        </shape>
    </item>
</selector>
